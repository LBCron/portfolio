{
  "ci": {
    "collect": {
      "startServerCommand": "bun run start -p 3102",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3102/en",
        "http://localhost:3102/pt",
        "http://localhost:3102/en/projects",
        "http://localhost:3102/pt/projects",
        "http://localhost:3102/en/projects/orbit-dashboard",
        "http://localhost:3102/pt/projects/orbit-dashboard"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "categories:performance": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 3800
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 350
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
